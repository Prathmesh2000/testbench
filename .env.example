# Local development defaults. Copy to .env (every app and script reads the root .env).
# These credentials only exist inside the local Docker stack — never reuse them anywhere else.

# Application role: RLS applies to it. Migrations and seed use the owner role instead.
DATABASE_URL=postgres://tb_app:tb_app_dev@localhost:5433/testbench
DATABASE_OWNER_URL=postgres://tb_owner:tb_owner_dev@localhost:5433/testbench

VALKEY_URL=redis://localhost:6379

OIDC_ISSUER=http://localhost:8080/realms/testbench
OIDC_AUDIENCE=core-api
OIDC_CLIENT_ID=testbench-web
OIDC_CLIENT_SECRET=testbench-web-dev-secret
# Keycloak runs on plain HTTP locally; openid-client refuses that unless told otherwise.
OIDC_ALLOW_HTTP=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=testbench
S3_SECRET_KEY=testbench-dev-secret
S3_BUCKET=testbench-evidence

CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Encrypts the session cookies. Any string of 32+ characters.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
LOG_LEVEL=info
