# Local development defaults. Copy to .env (every app and script reads the root .env).
# These credentials only exist inside the local Docker stack — never reuse them anywhere else.

# Application role: RLS applies to it. Migrations and seed use the owner role instead.
DATABASE_URL=postgres://tb_app:tb_app_dev@localhost:5433/testbench
DATABASE_OWNER_URL=postgres://tb_owner:tb_owner_dev@localhost:5433/testbench

VALKEY_URL=redis://localhost:6379

OIDC_ISSUER=http://localhost:8080/realms/testbench
OIDC_AUDIENCE=core-api
OIDC_CLIENT_ID=testbench-web
OIDC_CLIENT_SECRET=testbench-web-dev-secret
# Keycloak runs on plain HTTP locally; openid-client refuses that unless told otherwise.
OIDC_ALLOW_HTTP=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=testbench
S3_SECRET_KEY=testbench-dev-secret
S3_BUCKET=testbench-evidence

OPENSEARCH_URL=http://localhost:9200

# Jira: each tester connects their own account in Settings → Jira. Locally, connect to the sandbox
# (infra/local/jira-sandbox) with site http://localhost:8090, any email and token jira-sandbox-token.
JIRA_TOKEN_SECRET=local-jira-token-secret-change-me-32chars
JIRA_SITE_PATTERN=^(https://[a-z0-9][a-z0-9-]*\.atlassian\.net|http://localhost:8090)$

# Notification service (deploy/notification-local): DynamoDB and SQS locally, Mailpit for email,
# the provider sandbox for SMS. core-api calls it with the service key.
NOTIFY_URL=http://localhost:4100
NOTIFY_SERVICE_KEY=local-dev-notify-service-key-0123456789
DYNAMODB_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:9324
SMTP_URL=smtp://localhost:1025
NOTIFY_EMAIL_FROM=Testbench <testbench@paytrail.in>
SMS_SANDBOX_URL=http://localhost:8091/sms
# Lets channels point at the local provider sandbox (http://localhost:8091/slack/…). Never set in production.
NOTIFY_ALLOW_LOCAL_TARGETS=true

CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Encrypts the session cookies. Any string of 32+ characters.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
LOG_LEVEL=info

# AI provider layer (HLD §2.3, §10.3). local = Ollama only, nothing leaves the laptop;
# cloud = the provider keys below; mock = recorded answers (what the tests use).
# Local setup: install Ollama (or `docker compose --profile ai up -d`), then `ollama pull qwen3:4b`.
AI_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
AI_LOCAL_MODEL=qwen3:4b
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# Model ids are configuration; change them as providers release new ones.
AI_OPENAI_MODEL=gpt-5-mini
AI_ANTHROPIC_MODEL=claude-sonnet-5
AI_XAI_MODEL=grok-4
# Encrypts tenant-supplied API keys (bring your own key). Any string of 32+ characters.
AI_KEY_SECRET=local-dev-ai-key-secret-change-me-0123456789

# Keycloak admin API: invitations from the admin console create accounts here (local realm only).
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=testbench
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The agent gateway (MCP server + Slack bot).
AGENT_GATEWAY_URL=http://localhost:4200
# Slack bot: the app's signing secret, and a key that encrypts linked tokens. Locally, the provider
# sandbox's Slack console (http://localhost:8091/slack-console) signs with the same secret.
SLACK_SIGNING_SECRET=local-dev-slack-signing-secret-0123
SLACK_TOKEN_SECRET=local-dev-slack-token-secret-change-me-0123456789

# Live boards: the collaboration server (Hocuspocus) and the secret core-api signs its tickets with.
COLLAB_URL=ws://localhost:4300
COLLAB_PORT=4300
COLLAB_SECRET=local-dev-collab-secret-change-me-0123456789

# Test Browser (deploy/browser-live): core-api signs session tickets with this; the server checks them.
BROWSER_URL=ws://localhost:4400
BROWSER_SECRET=local-dev-browser-secret-change-me-0123456789
# Local only: lets the Test Browser open apps on localhost. Never set in AWS (it disables the SSRF guard).
BROWSER_ALLOW_PRIVATE=true

# Headless runner (deploy/runner). RUNNER_HEADED=true opens a visible browser window per test on this
# machine, slowed down so you can watch your site being tested. Leave false on servers.
RUNNER_CONCURRENCY=4
RUNNER_HEADED=false
# Meeting invites go here; the provider sandbox records them (Google/M365 connectors replace it in AWS).
CALENDAR_URL=http://localhost:8091/calendar
